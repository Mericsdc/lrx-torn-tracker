# Documentation template only. No real credentials belong in this repository.
# Load these with Node 24: node --env-file=/private/path/premium.env premium/server.js
PREMIUM_MODE=test
PREMIUM_HOST=127.0.0.1
PREMIUM_PORT=3740
PREMIUM_DB_PATH=./data/premium-test.sqlite
PREMIUM_RECEIVER_TORN_ID=4037017
PREMIUM_ADMIN_TORN_IDS=4037017
PREMIUM_REVIEW_RETENTION_DAYS=30
# Set a random secret (at least 32 characters) only for a LOCAL test installation.
PREMIUM_TEST_AUTH_TOKEN=

# Live prerequisites: never enable without Torn staff approval for this exact model.
PREMIUM_ALLOW_LIVE_PAYMENTS=false
PREMIUM_TORN_APPROVAL_REFERENCE=
PREMIUM_RECEIVER_FORMAT_VERIFIED=false
PREMIUM_RECEIVER_API_KEY=
PREMIUM_PUBLIC_URL=
PREMIUM_CONTROLLER_NAME=
PREMIUM_PRIVACY_CONTACT=
PREMIUM_RECORD_RETENTION_POLICY=

# Desktop process configuration (not receiver-service credentials).
# The production URL must be an HTTPS origin, e.g. https://premium.example.org
TORN_PREMIUM_SERVICE_URL=
TORN_PREMIUM_TEST_MODE=0
# Local tests only: match PREMIUM_TEST_AUTH_TOKEN and choose a SYNTHETIC identity.
TORN_PREMIUM_TEST_TOKEN=
TORN_PREMIUM_TEST_TORN_ID=
